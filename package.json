{
  "name": "ahead-of-it",
  "private": true,
  "version": "0.1.0",
  "description": "Occupancy / \"Ahead of It\" — resume.joshgister.com. Vanilla TypeScript + Vite, no UI framework (D-009).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/run-build-content.mjs",
    "build": "vite build && npm run check:employer",
    "preview": "vite preview --port 4173 --strictPort",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check:employer": "bash scripts/check-employer.sh",
    "check:serving": "bash scripts/check-serving.sh",
    "kit:hallway": "node tools/hallway-test/build-kit.mjs",
    "check:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "check": "npm run build && npm run test && npm run check:serving && npm run check:lighthouse"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.138.0"
  }
}
