{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume.joshgister.com/schema/content.json",
  "title": "Occupancy content (PH1-03)",
  "description": "Generated by scripts/build-content.ts from docs/content/*.md. Do not hand-edit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bands", "gags", "beyond", "copy", "ui", "ambient"],
  "properties": {
    "bands": {
      "type": "array",
      "items": { "$ref": "#/$defs/band" }
    },
    "gags": {
      "type": "array",
      "items": { "$ref": "#/$defs/gag" }
    },
    "beyond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel", "translation"],
      "properties": {
        "panel": { "$ref": "#/$defs/panel" },
        "translation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["receipt", "atScale"],
            "properties": {
              "receipt": { "type": "string", "minLength": 1 },
              "atScale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toggleToWithout",
        "toggleToBuilt",
        "nudge",
        "shareCaption",
        "ogTitle",
        "ogDescription",
        "sliderLabel",
        "contact"
      ],
      "properties": {
        "toggleToWithout": { "type": "string", "minLength": 1 },
        "toggleToBuilt": { "type": "string", "minLength": 1 },
        "nudge": { "type": "string", "minLength": 1 },
        "shareCaption": { "type": "string", "minLength": 1 },
        "ogTitle": { "type": "string", "minLength": 1 },
        "ogDescription": { "type": "string", "minLength": 1 },
        "sliderLabel": { "type": "string", "minLength": 1 },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linkedin", "email"],
          "properties": {
            "linkedin": { "type": "string", "minLength": 1 },
            "email": {
              "type": "object",
              "additionalProperties": false,
              "required": ["user", "domain"],
              "properties": {
                "user": { "type": "string", "minLength": 1 },
                "domain": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "roomHint",
        "wholeFloor",
        "previous",
        "next",
        "position",
        "zoomIn",
        "atStart",
        "atEnd",
        "roomTab",
        "roomTabName",
        "announce",
        "announceRoom",
        "announceWithout",
        "announceBuilt",
        "loading",
        "loadFailed",
        "retry",
        "readoutAtBand",
        "shareButton",
        "shareButtonName"
      ],
      "properties": {
        "intro": { "type": "string", "minLength": 1 },
        "roomHint": { "type": "string", "minLength": 1 },
        "wholeFloor": { "type": "string", "minLength": 1 },
        "previous": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 },
        "position": { "type": "string", "minLength": 1 },
        "zoomIn": { "type": "string", "minLength": 1 },
        "atStart": { "type": "string", "minLength": 1 },
        "atEnd": { "type": "string", "minLength": 1 },
        "roomTab": { "type": "string", "minLength": 1 },
        "roomTabName": { "type": "string", "minLength": 1 },
        "announce": { "type": "string", "minLength": 1 },
        "announceRoom": { "type": "string", "minLength": 1 },
        "announceWithout": { "type": "string", "minLength": 1 },
        "announceBuilt": { "type": "string", "minLength": 1 },
        "loading": { "type": "string", "minLength": 1 },
        "loadFailed": { "type": "string", "minLength": 1 },
        "retry": { "type": "string", "minLength": 1 },
        "readoutAtBand": { "type": "string", "minLength": 1 },
        "shareButton": { "type": "string", "minLength": 1 },
        "shareButtonName": { "type": "string", "minLength": 1 }
      }
    },
    "ambient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hover"],
      "properties": {
        "hover": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "bandId": {
      "enum": [80, 150, 220, 360, 490, 610, 750, "beyond"]
    },
    "strip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "headcount", "descriptor"],
      "properties": {
        "year": { "type": "string", "minLength": 1 },
        "headcount": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "string", "minLength": 1 }
      }
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "year", "people", "title", "intro"],
      "properties": {
        "id": { "$ref": "#/$defs/bandId" },
        "year": { "type": ["string", "null"] },
        "people": { "type": ["string", "null"] },
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "strip", "already", "prevented", "receipts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "strip": { "$ref": "#/$defs/strip" },
        "already": { "type": "string", "minLength": 1 },
        "prevented": { "type": "string", "minLength": 1 },
        "worthLater": { "type": "string" },
        "receipts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^E-[0-9]+$" }
        }
      }
    },
    "gag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "band",
        "title",
        "strip",
        "already",
        "prevented",
        "receipts",
        "where",
        "without",
        "built"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "band": { "$ref": "#/$defs/bandId" },
        "title": { "type": "string", "minLength": 1 },
        "strip": { "$ref": "#/$defs/strip" },
        "already": { "type": "string", "minLength": 1 },
        "prevented": { "type": "string", "minLength": 1 },
        "worthLater": { "type": "string" },
        "receipts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^E-[0-9]+$" }
        },
        "where": { "type": "string", "minLength": 1 },
        "without": { "type": "string", "minLength": 1 },
        "built": { "type": "string", "minLength": 1 }
      }
    }
  }
}
