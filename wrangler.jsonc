{
  "name": "ahead-of-it",
  "compatibility_date": "2026-09-24",

  // PH3-04 (DIA-230): a thin Worker script alongside the static assets,
  // for the /u/* first-party analytics proxy (src/worker/index.ts). Only
  // ./dist (Vite's build output) is uploaded as assets, so .git, docs/ and
  // this file never become public URLs (R-26). Cloudflare matches a
  // request against a static asset first and only invokes the Worker for
  // anything that doesn't match (developers.cloudflare.com/workers/
  // static-assets/binding) — every route except /u/* and `/` (below) is
  // served exactly as it was when this was assets-only, either directly (a
  // real file) or via the Worker's own env.ASSETS.fetch() fallback, which
  // re-applies not_found_handling itself (public/404.html backs it, same
  // as joshgister).
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // D-057 (PH3-02, DIA-235): `/` matches the static index.html, so
    // without this it would never reach the Worker and every `?n=` would
    // unfurl as band 80's og:image forever. Naming only `/` (not every
    // path) keeps every other static file — sprites, scene JSON, share
    // PNGs, /u/* itself — on the assets-first path, unchanged. Nested
    // under `assets`, not top-level (DIA-248): wrangler only reads
    // `run_worker_first` from here — at the top level it's silently
    // ignored ("Unexpected fields found in top-level field") and every
    // link previews as band 80 forever, which the unit tests can't catch
    // because they call the Worker directly and skip the routing decision
    // this makes. src/worker/wrangler-config.test.ts guards the nesting.
    "run_worker_first": ["/"]
  },

  // DIA-226/DIA-254: the website id and proxy-location questions are
  // answered — Josh gave the id (wired as VITE_UMAMI_WEBSITE_ID, a CI repo
  // variable, R-33-style, since it's public and ships in the page anyway),
  // and CEO ruled the proxy stays in this Worker. Josh supplied the Umami
  // host on DIA-254 (the tracker embed for resume.joshgister.com), so it's
  // set below — /u/* now proxies for real instead of 404ing.
  "vars": {
    "UMAMI_HOST": "https://umami.febrile.net"
  },

  // No custom domain / routes yet (Phase 4 — D-005, D-018: noindex until the
  // publicity gate opens). Left on the workers.dev subdomain for now so a
  // deploy has a real URL to smoke-test; revisit at the DNS cutover.
  "workers_dev": true,
  "preview_urls": true
}
